{
  "routes": [
    {
      "routePath": "/api/auth/session",
      "mountPath": "/api/auth",
      "method": "GET",
      "module": [
        "api/auth/session.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/auth/signin",
      "mountPath": "/api/auth",
      "method": "POST",
      "module": [
        "api/auth/signin.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/deposits/create",
      "mountPath": "/api/deposits",
      "method": "POST",
      "module": [
        "api/deposits/create.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/deposits/status",
      "mountPath": "/api/deposits",
      "method": "GET",
      "module": [
        "api/deposits/status.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/deposits/webhook",
      "mountPath": "/api/deposits",
      "method": "POST",
      "module": [
        "api/deposits/webhook.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/notify",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/notify.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/send-code",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/send-code.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/signup",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/signup.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/",
      "mountPath": "/",
      "method": "",
      "middleware": [
        "_middleware.ts:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}